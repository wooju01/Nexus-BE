# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_dev?schema=public

# CORS (FE 오리진)
CORS_ORIGIN=http://localhost:3000

# Mail (Nodemailer SMTP)
# 비워두면 메일 발송이 disabled — invitation 토큰 링크만 응답으로 반환됨.
# Mailtrap 예시: SMTP_HOST=sandbox.smtp.mailtrap.io / SMTP_PORT=2525
# Gmail 예시:    SMTP_HOST=smtp.gmail.com         / SMTP_PORT=587 (앱 비밀번호 필요)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Nexus <noreply@nexus.local>

# 메일 본문에 들어갈 FE 도메인 (초대 수락 링크의 origin)
APP_BASE_URL=http://localhost:3000

# (도입 후) Redis
# REDIS_URL=redis://localhost:6379

# (도입 후) Auth
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# (도입 후) 관측성
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# (도입 후) AI / LLM
# LLM_API_KEY=
# LLM_BASE_URL=
